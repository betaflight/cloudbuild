FROM betaflight/cloudbuild:base

ARG COMMIT="master"
ARG REPO="https://github.com/betaflight/betaflight.git"

RUN echo "Cloning ${REPO} @ ${COMMIT}"

RUN git clone -b ${COMMIT} ${REPO} /source

WORKDIR /source

RUN git checkout ${COMMIT}

ARG NOCACHE="1"

RUN git pull origin ${COMMIT}:${COMMIT}

# Populate config submodule
RUN git submodule update --init --checkout -- src/config

# Populate PICO SDK (recursive for nested submodules)
RUN git submodule update --init --checkout --recursive -- lib/main/pico-sdk

# Populate STM32CubeN6 and its required nested driver submodules
RUN git submodule update --init --checkout -- lib/main/STM32N6 && \
    cd lib/main/STM32N6 && git submodule update --init --checkout -- \
        Drivers/STM32N6xx_HAL_Driver \
        Drivers/CMSIS/Device/ST/STM32N6xx

# Build and install picotool (required for PICO UF2 targets)
RUN make picotool_install
